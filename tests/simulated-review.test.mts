import test from 'node:test';
import assert from 'node:assert/strict';
import { parseGeneratedGuidance } from '../src/lib/schemas.ts';

const nextStep = { objective: 'Reducir una duda concreta.', question: '¿Qué ayuda a avanzar?', why: 'Aporta información antes de decidir.', action: 'Observar una actividad comparable.', responsible: 'Docente', indicator: 'Registrar inicio y tipo de apoyo.', reviewIn: 'En una semana' };
const hypothesis = { title: 'Una posibilidad abierta', possibility: 'el formato de la actividad podría influir', supporting: ['La participación varió entre formatos.'], missing: ['Observar más de una ocasión.'], alternatives: ['También podrían influir el tiempo o el agrupamiento.'] };

function simulatedGuidance(overrides: Record<string, unknown> = {}) {
  return {
    summary: 'Primero aclaremos una cuestión y observemos un paso pequeño.', goalClear: true,
    goalClarificationQuestion: '¿Qué aprendizaje se esperaba?', studentVoiceStatus: 'pending', studentVoice: '', studentQuestion: '¿Qué te ayudaría a participar en esta actividad?',
    observations: ['La participación varía según la actividad.'], interpretations: [], pending: ['Falta una segunda observación.'], hypotheses: [hypothesis],
    diversification: [{ principle: 'acción y expresión', barrier: 'El formato de respuesta podría limitar cómo muestra lo que sabe.', evidence: 'Explica oralmente, pero necesita apoyo para organizar una respuesta escrita.', learningGoal: 'Comunicar una explicación usando evidencia.', strategy: 'Permitir un esquema inicial y después una respuesta escrita con la misma meta.', strengthOrInterest: 'La explicación oral está descrita como un recurso observado.', indicator: 'Si presenta una explicación escrita con evidencia y qué apoyo usa.', level: 'ordinaria' }],
    nextStep, caution: 'La diferencia observada no explica por sí sola la causa.', ...overrides,
  };
}

const simulations = [
  { id: 'S01-meta-ausente', output: simulatedGuidance({ summary: 'Antes de adaptar, aclaremos la meta de aprendizaje.', goalClear: false, diversification: [{ principle: 'no aplica', barrier: 'No está anotada la meta.', evidence: 'La descripción no indica qué aprendizaje se buscaba.', learningGoal: 'Pendiente de aclaración.', strategy: 'Preguntar a quien planificó la actividad qué debía aprenderse y cómo se demostraría.', strengthOrInterest: '', indicator: 'Meta y criterio de éxito anotados.', level: 'ordinaria' }] }), assert: (g: ReturnType<typeof parseGeneratedGuidance>) => { assert.equal(g.goalClear, false); assert.equal(g.diversification[0].principle, 'no aplica'); } },
  { id: 'S02-evidencia-limitada', output: simulatedGuidance({ observations: ['En una sesión participó poco.'], pending: ['Faltan otras sesiones y la voz del estudiante.'], diversification: [{ principle: 'no aplica', barrier: 'No se identifica aún una barrera estable.', evidence: 'Solo se dispone de una sesión.', learningGoal: 'Compartir una idea y justificarla.', strategy: 'Preguntar al estudiante cómo prefiere participar y observar otra actividad comparable antes de cambiar la tarea.', strengthOrInterest: '', indicator: 'Registrar participación en dos formatos.', level: 'ordinaria' }] }), assert: (g: ReturnType<typeof parseGeneratedGuidance>) => assert.equal(g.diversification.length, 1) },
  { id: 'S03-voz-conocida', output: simulatedGuidance({ studentVoiceStatus: 'known', studentVoice: 'La persona pidió empezar con un esquema.', studentQuestion: '¿El esquema te sigue ayudando?', diversification: [{ principle: 'representación', barrier: 'La consigna en bloque puede dificultar encontrar el inicio.', evidence: 'La persona pidió usar un esquema para empezar.', learningGoal: 'Organizar una explicación con evidencia.', strategy: 'Presentar la consigna en pasos y ofrecer el esquema elegido como apoyo inicial.', strengthOrInterest: 'La preferencia por el esquema fue expresada explícitamente.', indicator: 'Si inicia y completa la explicación con la misma meta.', level: 'ordinaria' }] }), assert: (g: ReturnType<typeof parseGeneratedGuidance>) => assert.equal(g.studentVoiceStatus, 'known') },
  { id: 'S04-informacion-contradictoria', output: simulatedGuidance({ studentVoiceStatus: 'contradictory', studentVoice: 'En una ocasión pidió trabajar solo; en otra eligió el grupo pequeño.', studentQuestion: '¿Qué formato prefieres para esta tarea concreta?', interpretations: ['La preferencia podría depender de la tarea o del momento.'], diversification: [{ principle: 'implicación', barrier: 'Una única modalidad de agrupamiento puede no servir en todas las tareas.', evidence: 'Se describen dos preferencias distintas en ocasiones diferentes.', learningGoal: 'Comparar estrategias y construir una solución conjunta.', strategy: 'Ofrecer elección entre trabajo individual inicial y conversación en pareja, manteniendo el cierre colaborativo.', strengthOrInterest: 'No se infiere una preferencia fija; se recogen dos elecciones reportadas.', indicator: 'Qué opción elige y si contribuye al acuerdo común.', level: 'ordinaria' }] }), assert: (g: ReturnType<typeof parseGeneratedGuidance>) => assert.equal(g.studentVoiceStatus, 'contradictory') },
  { id: 'S05-reto-y-apoyo', output: simulatedGuidance({ observations: ['Resuelve ejercicios rutinarios con rapidez.', 'En una tarea abierta necesita ayuda para ordenar el procedimiento.'], interpretations: ['Podrían coexistir dominio de una parte y necesidad de apoyo en otra.'], diversification: [{ principle: 'acción y expresión', barrier: 'La tarea rutinaria no permite observar transferencia y la tarea abierta añade demanda de organización.', evidence: 'Hay evidencia reportada en ambos tipos de tarea.', learningGoal: 'Aplicar una estrategia y explicar el razonamiento.', strategy: 'Proponer un problema nuevo que mantenga la meta y permitir elegir un organizador para ordenar la explicación.', strengthOrInterest: 'No se reportó un interés concreto; no se presupone.', indicator: 'Si transfiere la estrategia y qué organizador necesita.', level: 'ordinaria' }] }), assert: (g: ReturnType<typeof parseGeneratedGuidance>) => { assert.equal(g.diversification[0].learningGoal, 'Aplicar una estrategia y explicar el razonamiento.'); assert.doesNotMatch(JSON.stringify(g), /diagnóstico|TDAH|TEA|altas capacidades/i); } },
];

test('cinco respuestas pedagógicas simuladas pasan esquema y controles de escenario', () => {
  assert.equal(simulations.length, 5);
  for (const item of simulations) item.assert(parseGeneratedGuidance(item.output));
});

test('el esquema rechaza una opción sin evidencia identificable', () => {
  const invalid = simulatedGuidance({ diversification: [{ principle: 'representación', barrier: 'La consigna puede dificultar el acceso.', evidence: '', learningGoal: 'Comunicar una explicación usando evidencia.', strategy: 'Dar un esquema para comenzar.', strengthOrInterest: '', indicator: 'Si inicia con el esquema.', level: 'ordinaria' }] });
  assert.throws(() => parseGeneratedGuidance(invalid));
});
